{
  "name": "aliquo",
  "version": "0.1.0",
  "private": true,
  "description": "Aliquo — monorepo (apps/simulador, apps/landing)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/simulador",
    "dev:simulador": "npm run dev --workspace=apps/simulador",
    "dev:landing": "npm run dev --workspace=apps/landing --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.11"
  }
}
