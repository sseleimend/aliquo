# ─────────────────────────────────────────────────────────────
# Aliquo — variáveis de ambiente (copie para .env e ajuste)
# ─────────────────────────────────────────────────────────────

# Banco de dados (SQLite local para o protótipo)
DATABASE_URL="file:./dev.db"

# ─────────────────────────────────────────────────────────────
# Turso (libSQL) — banco de PRODUÇÃO. Deixe vazio em desenvolvimento.
#
# Preenchido, tem precedência sobre DATABASE_URL: a aplicação e os scripts
# passam a falar com o banco remoto. É o mesmo dialeto SQLite (FTS5 e bm25
# inclusive), então nenhuma query muda.
#
#   turso db show aliquo --url        -> TURSO_DATABASE_URL
#   turso db tokens create aliquo     -> TURSO_AUTH_TOKEN
#
# Para uma execução pontual contra produção, prefira passar no shell em vez de
# gravar aqui — senão o `npm run dev` local também vai para produção:
#   TURSO_DATABASE_URL=... TURSO_AUTH_TOKEN=... npm run ncm:index
# ─────────────────────────────────────────────────────────────
TURSO_DATABASE_URL="libsql://seu-banco.aws-us-east-1.turso.io"
TURSO_AUTH_TOKEN="troque-pelo-token-gerado-com-turso-db-tokens-create"

# Onde ficam os bytes das faturas enviadas: local (var/uploads/) ou db
# (tabela ArquivoBlob). Vazio = segue o banco: remoto -> db, arquivo -> local.
# Host gratuito não tem disco persistente, então lá o valor é "db".
STORAGE_DRIVER="db"

# Auth.js / NextAuth — segredo de sessão (gere um valor aleatório)
# Ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="troque-por-um-valor-aleatorio-em-producao"
# URL base da app (necessária em produção; em dev pode ficar padrão)
# NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# Provider de LLM (chat de descoberta de NCM) — SUBSTITUÍVEL
#   mock      -> regras determinísticas, roda sem chave (padrão)
#   ollama    -> Ollama Cloud (endpoint OpenAI-compatível)
#   anthropic -> API da Anthropic
#   gemini    -> API do Google Gemini
# ─────────────────────────────────────────────────────────────
LLM_PROVIDER="mock"

# --- Ollama Cloud ---
OLLAMA_BASE_URL="https://ollama.com"
OLLAMA_API_KEY=""
OLLAMA_MODEL="gpt-oss:120b"

# --- Anthropic (troca futura) ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Google Gemini ---
# Use um modelo disponível para sua conta. "gemini-flash-latest" aponta sempre
# para o flash atual. Modelos 2.5/3.x usam "thinking" (o provider já reserva
# folga de tokens para isso). Evite ids antigos como "gemini-2.5-flash", que
# retornam 404 "no longer available to new users" em contas novas.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"

# ─────────────────────────────────────────────────────────────
# Câmbio (FX) — SUBSTITUÍVEL
#   awesomeapi -> cotação REAL (economia.awesomeapi.com.br, sem chave) [padrão]
#   mock       -> taxas de amostra fixas
# ─────────────────────────────────────────────────────────────
FX_PROVIDER="awesomeapi"

# ---------------------------------------------------------------------------
# Custo por operação de IA (RNF-5)
# ---------------------------------------------------------------------------
# JSON mapeando MODELO (ou nome do provider) para o preço. Dois formatos,
# porque os providers cobram de formas diferentes:
#
#   por token   -> {"entradaUsdMilhao": N, "saidaUsdMilhao": N}   (USD por 1M tokens)
#   assinatura  -> {"assinaturaUsdMes": N}                        (mensalidade fixa)
#
# Ollama Cloud NÃO cobra por token: é assinatura mensal com limite de GPU-time,
# então o custo por simulação sai do rateio da mensalidade (npm run custo:ia).
#
# Confirme os valores na página de preços/faturamento de cada provider — eles
# mudam sem aviso e variam por contrato. Sem configuração, o custo fica
# registrado como desconhecido (nunca como zero).
#
# LLM_PRECOS='{"gpt-oss:120b":{"assinaturaUsdMes":20},"claude-sonnet-5":{"entradaUsdMilhao":3,"saidaUsdMilhao":15},"gemini":{"entradaUsdMilhao":0.3,"saidaUsdMilhao":2.5}}'
